<%- include("../partials/head", { title: "Contact", description: "Get in touch with the SupportFlow team." }) %>
<%- include("../partials/header") %>

<main id="main">
    <div class="page-head">
        <div>
            <span class="eyebrow">Contact</span>
            <h1>Get in touch</h1>
            <p class="lead">Questions, feedback or a privacy request? Send us a message and we will reply as soon as we can.</p>
        </div>
    </div>

    <div class="form-layout">
        <form id="contactForm" class="form card">
            <div class="form-row">
                <div class="field">
                    <label for="contactName">Your name</label>
                    <input id="contactName" autocomplete="name" required>
                </div>
                <div class="field">
                    <label for="contactEmailField">Your email</label>
                    <input id="contactEmailField" type="email" autocomplete="email" required>
                </div>
            </div>
            <div class="field">
                <label for="contactSubject">Subject</label>
                <input id="contactSubject" required>
            </div>
            <div class="field">
                <label for="contactBody">Message</label>
                <textarea id="contactBody" required></textarea>
                <span class="hint">This opens your email app with the message ready to send.</span>
            </div>
            <button type="submit" class="btn btn-primary">Send message</button>
        </form>

        <aside class="card">
            <p class="side-title">Other ways to reach us</p>
            <dl class="kv" style="grid-template-columns:1fr">
                <div>
                    <dt>Email</dt>
                    <dd><a href="mailto:bridewithney@gmail.com">bridewithney@gmail.com</a></dd>
                </div>
                <div>
                    <dt>Help</dt>
                    <dd><a href="/help">Read the FAQ</a></dd>
                </div>
            </dl>
        </aside>
    </div>
</main>

<script>
document.getElementById("contactForm").addEventListener("submit", function (event) {
    event.preventDefault();

    var name = document.getElementById("contactName").value;
    var email = document.getElementById("contactEmailField").value;
    var subject = document.getElementById("contactSubject").value;
    var body = document.getElementById("contactBody").value;

    window.location.href =
        "mailto:bridewithney@gmail.com?subject=" + encodeURIComponent(subject) +
        "&body=" + encodeURIComponent(body + "\n\nFrom: " + name + " (" + email + ")");
});
</script>

<%- include("../partials/footer") %>
