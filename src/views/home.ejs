<%- include("partials/head", { title: "Customer support, organised", description: "SupportFlow helps organizations receive, assign and resolve customer support requests with separate workspaces, role-based access and built-in conversations." }) %>
<%- include("partials/header") %>

<main id="main">
    <section class="hero">
        <div>
            <span class="eyebrow">Multi-tenant support platform</span>
            <h1>Customer support that keeps every request <em>on track</em>.</h1>
            <p class="lead">
                SupportFlow gives each organization its own workspace to receive
                requests, assign them to agents and talk with customers, all in one place.
            </p>

            <div class="hero-actions" id="heroGuest">
                <a class="btn btn-primary btn-lg" href="/organizations/register">Register your organization</a>
                <a class="btn btn-secondary btn-lg" href="/customer/login">Customer sign in</a>
            </div>

            <div class="hero-actions" id="heroUser" hidden>
                <a class="btn btn-primary btn-lg" id="heroDashboard" href="/">Go to your dashboard</a>
            </div>

            <p class="hero-note">Separate workspaces. Role-based access. Hashed passwords.</p>
        </div>

        <div class="preview" aria-hidden="true">
            <div class="preview-bar">
                <div class="avatar">G</div>
                <div>
                    <strong>Login issue</strong>
                    <span class="meta" style="display:block">Assigned to Grace</span>
                </div>
                <span class="badge status-in-progress" style="margin-left:auto">in progress</span>
            </div>
            <div class="preview-body">
                <div class="day"><span>Today</span></div>
                <div class="msg mine first">
                    <div class="bubble">
                        <span class="txt">I cannot sign in to my account.</span>
                        <span class="time">9:41</span>
                    </div>
                </div>
                <div class="msg theirs first">
                    <div class="bubble">
                        <div class="who">~ Grace</div>
                        <span class="txt">Hi, I am looking into it now. Please try again in a minute.</span>
                        <span class="time">9:44</span>
                    </div>
                </div>
                <div class="msg mine first">
                    <div class="bubble">
                        <span class="txt">That worked, thank you!</span>
                        <span class="time">9:47</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="features">
        <div class="section-head">
            <span class="eyebrow">Features</span>
            <h2>Everything a support team needs</h2>
            <p>Built around the way real support desks work, from the first message to the final resolution.</p>
        </div>

        <div class="grid cols-3">
            <div class="card feature">
                <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M8 7h4M8 11h4M8 15h4M3 21h18"/></svg></div>
                <h3>Separate workspaces</h3>
                <p>Every organization has its own users and requests, kept apart from everyone else's data.</p>
            </div>
            <div class="card feature">
                <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.2a3.2 3.2 0 0 1 0 5.6M21 20c0-2.6-1.6-4.8-4-5.6"/></svg></div>
                <h3>Four clear roles</h3>
                <p>Customers, agents, managers and administrators each see only what their role allows.</p>
            </div>
            <div class="card feature">
                <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11M9 12h11M9 18h11M4 6l1.2 1.2L7 5.4M4 12l1.2 1.2L7 11.4M4 18l1.2 1.2L7 17.4"/></svg></div>
                <h3>Status and priority tracking</h3>
                <p>Follow each request from open to resolved, with priority levels that help teams focus.</p>
            </div>
            <div class="card feature">
                <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></div>
                <h3>Built-in conversations</h3>
                <p>Chat with customers on every request in a familiar messaging layout.</p>
            </div>
            <div class="card feature">
                <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z"/></svg></div>
                <h3>Fast assignment</h3>
                <p>Managers assign requests to the right agent and update their status in a few clicks.</p>
            </div>
            <div class="card feature">
                <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg></div>
                <h3>Secure by design</h3>
                <p>Passwords are hashed and sign-in tokens expire, so accounts stay protected.</p>
            </div>
        </div>
    </section>

    <section class="section" id="how">
        <div class="section-head">
            <span class="eyebrow">How it works</span>
            <h2>Up and running in three steps</h2>
        </div>

        <div class="steps">
            <div class="step">
                <h3>Create a workspace</h3>
                <p>Register your organization and receive a workspace slug along with your administrator account.</p>
            </div>
            <div class="step">
                <h3>Invite your people</h3>
                <p>Staff and customers register with your slug and are placed in your workspace automatically.</p>
            </div>
            <div class="step">
                <h3>Resolve requests</h3>
                <p>Customers submit requests, managers assign them, and agents reply until the issue is resolved.</p>
            </div>
        </div>
    </section>

    <section class="section" id="portals" data-guest-only>
        <div class="section-head">
            <span class="eyebrow">Get started</span>
            <h2>Choose your portal</h2>
        </div>

        <div class="grid cols-3">
            <div class="card portal">
                <h3>Customers</h3>
                <p>Submit support requests, follow their progress and message the support team.</p>
                <div class="links">
                    <a class="btn btn-primary btn-sm" href="/customer/login">Sign in</a>
                    <a class="btn btn-secondary btn-sm" href="/customer/register">Create account</a>
                </div>
            </div>
            <div class="card portal">
                <h3>Support staff</h3>
                <p>Agents and managers handle assigned requests and keep customers updated.</p>
                <div class="links">
                    <a class="btn btn-primary btn-sm" href="/staff/login">Staff login</a>
                    <a class="btn btn-secondary btn-sm" href="/staff/register">Staff registration</a>
                </div>
            </div>
            <div class="card portal">
                <h3>Organizations</h3>
                <p>Set up a private workspace and manage users, requests and assignments.</p>
                <div class="links">
                    <a class="btn btn-primary btn-sm" href="/organizations/register">Register organization</a>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-band" data-guest-only>
        <h2>Ready to organise your support?</h2>
        <p>Create your workspace in minutes and bring every request into one place.</p>
        <a class="btn btn-primary btn-lg" href="/organizations/register">Register your organization</a>
    </section>
</main>

<script>
(function () {
    var role = getUserRole();
    var dashboards = {
        customer: "/customer/dashboard",
        agent: "/agent/dashboard",
        admin: "/admin/dashboard",
        manager: "/admin/dashboard"
    };

    if (dashboards[role]) {
        document.getElementById("heroGuest").hidden = true;
        document.getElementById("heroUser").hidden = false;
        document.getElementById("heroDashboard").href = dashboards[role];

        document.querySelectorAll("[data-guest-only]").forEach(function (element) {
            element.hidden = true;
        });
    }
})();
</script>

<%- include("partials/footer") %>
