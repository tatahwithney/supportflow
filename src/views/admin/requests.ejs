<%- include("../partials/head", { title: "Request Management" }) %>
<%- include("../partials/header") %>

<main id="main">
    <a class="back-link" href="/admin/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        Back to dashboard
    </a>

    <div class="page-head">
        <div>
            <span class="eyebrow">Administration</span>
            <h1>Support requests</h1>
            <p class="lead">Assign agents and update the status of every request in your workspace.</p>
        </div>
    </div>

    <div id="requests" class="grid cards-wide">
        <p class="muted">Loading requests...</p>
    </div>

    <p id="message" class="alert toast" role="status"></p>
</main>

<script>
const token = getToken();

if (!token || !["admin", "manager"].includes(getUserRole())) {
    window.location.href = "/staff/login";
}

let agents = [];

async function loadAgents() {
    const response = await fetch("/api/users", {
        headers: {
            Authorization: `Bearer ${token}`
        }
    });

    if (response.status === 401) {
        handleUnauthorized();
        return;
    }

    const users = await response.json();

    if (!response.ok) {
        throw new Error(users.message);
    }

    agents = users.filter(
        user =>
            user.role === "agent" &&
            user.isActive
    );
}

async function loadRequests() {
    try {
        await loadAgents();

        const response = await fetch(
            "/api/requests",
            {
                headers: {
                    Authorization:
                        `Bearer ${token}`
                }
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const requests =
            await response.json();

        if (!response.ok) {
            throw new Error(
                requests.message
            );
        }

        const container =
            document.getElementById(
                "requests"
            );

        const message =
            document.getElementById(
                "message"
            );

        if (requests.length === 0) {
            message.textContent =
                "No support requests found.";

            container.className = "";
            container.innerHTML = '<div class="empty">No support requests found.</div>';
            return;
        }

        message.textContent = "";

        container.innerHTML = requests.map(request => {
            const statuses = [
                ["open", "Open"],
                ["in-progress", "In progress"],
                ["resolved", "Resolved"],
                ["closed", "Closed"]
            ];

            const agentOptions = agents.map(agent => `
                <option
                    value="${agent._id}"
                    ${request.assignedAgent?._id === agent._id ? "selected" : ""}
                >${escapeHtml(agent.name)}</option>
            `).join("");

            const statusOptions = statuses.map(([value, label]) => `
                <option
                    value="${value}"
                    ${request.status === value ? "selected" : ""}
                >${label}</option>
            `).join("");

            return `
                <article class="card req-card">
                    <div class="badges">
                        ${statusBadge(request.status)}
                        ${priorityBadge(request.priority)}
                        <span class="badge badge-muted">${escapeHtml(request.category)}</span>
                    </div>

                    <h3>${escapeHtml(request.title)}</h3>
                    <p class="clamp">${escapeHtml(request.description)}</p>

                    <dl class="kv">
                        <div>
                            <dt>Customer</dt>
                            <dd>${escapeHtml(request.customer?.name || "Unknown")}</dd>
                        </div>
                        <div>
                            <dt>Assigned agent</dt>
                            <dd>${escapeHtml(request.assignedAgent?.name || "Not assigned")}</dd>
                        </div>
                    </dl>

                    <div class="controls">
                        <div class="control">
                            <label for="agent-${request._id}">Assign agent</label>
                            <div class="control-row">
                                <select id="agent-${request._id}">
                                    <option value="">Select agent</option>
                                    ${agentOptions}
                                </select>
                                <button class="btn btn-secondary btn-sm" onclick="assignAgent('${request._id}')">Assign</button>
                            </div>
                        </div>

                        <div class="control">
                            <label for="status-${request._id}">Status</label>
                            <div class="control-row">
                                <select id="status-${request._id}">
                                    ${statusOptions}
                                </select>
                                <button class="btn btn-secondary btn-sm" onclick="updateStatus('${request._id}')">Update</button>
                            </div>
                        </div>
                    </div>
                </article>
            `;
        }).join("");
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            error.message ||
            "Unable to load requests.";
    }
}

async function assignAgent(requestId) {
    const agentId =
        document.getElementById(
            `agent-${requestId}`
        ).value;

    if (!agentId) {
        document.getElementById(
            "message"
        ).textContent =
            "Please select an agent.";

        return;
    }

    try {
        const response = await fetch(
            `/api/requests/${requestId}/assign`,
            {
                method: "PUT",

                headers: {
                    "Content-Type":
                        "application/json",

                    Authorization:
                        `Bearer ${token}`
                },

                body: JSON.stringify({
                    agentId
                })
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data =
            await response.json();

        document.getElementById(
            "message"
        ).textContent = data.message;

        if (response.ok) {
            loadRequests();
        }
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            "Unable to assign agent.";
    }
}

async function updateStatus(requestId) {
    const status =
        document.getElementById(
            `status-${requestId}`
        ).value;

    try {
        const response = await fetch(
            `/api/requests/${requestId}/status`,
            {
                method: "PUT",

                headers: {
                    "Content-Type":
                        "application/json",

                    Authorization:
                        `Bearer ${token}`
                },

                body: JSON.stringify({
                    status
                })
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data =
            await response.json();

        document.getElementById(
            "message"
        ).textContent = data.message;

        if (response.ok) {
            loadRequests();
        }
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            "Unable to update status.";
    }
}

loadRequests();
</script>

<%- include("../partials/footer") %>