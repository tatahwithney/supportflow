<%- include("../partials/head", { title: "User Management" }) %>
<%- include("../partials/header") %>

<main id="main">
    <a class="back-link" href="/admin/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        Back to dashboard
    </a>

    <div class="page-head">
        <div>
            <span class="eyebrow">Administration</span>
            <h1>User management</h1>
            <p class="lead">View accounts, change roles and deactivate users in your workspace.</p>
        </div>
    </div>

    <div id="users">
        <p class="muted">Loading users...</p>
    </div>

    <p id="message" class="alert toast" role="status"></p>
</main>

<script>
const token = getToken();

if (!token || !["admin", "manager"].includes(getUserRole())) {
    window.location.href = "/staff/login";
}

async function loadUsers() {
    try {
        const response = await fetch(
            "/api/users",
            {
                headers: {
                    Authorization:
                        `Bearer ${token}`
                }
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const users = await response.json();

        if (!response.ok) {
            document.getElementById(
                "message"
            ).textContent = users.message;

            return;
        }

        const container =
            document.getElementById("users");

        if (users.length === 0) {
            container.innerHTML =
                '<div class="empty">No users found.</div>';

            return;
        }

        container.innerHTML = `
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        ${users.map(user => `
                            <tr>
                                <td data-label="Name"><strong>${escapeHtml(user.name)}</strong></td>
                                <td data-label="Email">${escapeHtml(user.email)}</td>
                                <td data-label="Role">
                                    <select id="role-${user._id}" aria-label="Role for ${escapeHtml(user.name)}">
                                        ${["customer", "agent", "manager", "admin"].map(role => `
                                            <option value="${role}" ${user.role === role ? "selected" : ""}>
                                                ${role.charAt(0).toUpperCase() + role.slice(1)}
                                            </option>
                                        `).join("")}
                                    </select>
                                </td>
                                <td data-label="Status">
                                    <span class="badge ${user.isActive ? "status-resolved" : "status-closed"}">
                                        ${user.isActive ? "Active" : "Inactive"}
                                    </span>
                                </td>
                                <td data-label="Actions">
                                    <div class="actions">
                                        <button class="btn btn-secondary btn-sm" onclick="updateUser('${user._id}')">Save</button>
                                        ${user.isActive
                                            ? `<button class="btn btn-danger btn-sm" onclick="deactivateUser('${user._id}')">Deactivate</button>`
                                            : ""}
                                    </div>
                                </td>
                            </tr>
                        `).join("")}
                    </tbody>
                </table>
            </div>
        `;
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            "Unable to load users.";
    }
}

async function updateUser(userId) {
    const role =
        document.getElementById(
            `role-${userId}`
        ).value;

    try {
        const response = await fetch(
            `/api/users/${userId}`,
            {
                method: "PUT",

                headers: {
                    "Content-Type":
                        "application/json",

                    Authorization:
                        `Bearer ${token}`
                },

                body: JSON.stringify({
                    role
                })
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data =
            await response.json();

        document.getElementById(
            "message"
        ).textContent = data.message;

        if (response.ok) {
            loadUsers();
        }
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            "Unable to update user.";
    }
}

async function deactivateUser(userId) {
    const confirmed = confirm(
        "Deactivate this user?"
    );

    if (!confirmed) {
        return;
    }

    try {
        const response = await fetch(
            `/api/users/${userId}`,
            {
                method: "DELETE",

                headers: {
                    Authorization:
                        `Bearer ${token}`
                }
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data =
            await response.json();

        document.getElementById(
            "message"
        ).textContent = data.message;

        if (response.ok) {
            loadUsers();
        }
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            "Unable to deactivate user.";
    }
}

loadUsers();
</script>

<%- include("../partials/footer") %>