<%- include("../partials/head", { title: "Admin Dashboard" }) %>
<%- include("../partials/header") %>

<main id="main">
    <div class="page-head">
        <div>
            <span class="eyebrow">Administration</span>
            <h1>Workspace overview</h1>
            <p class="lead">Monitor users and support requests across your organization.</p>
        </div>
    </div>

    <div class="stats">
        <div class="stat">
            <span class="stat-label">Total users</span>
            <strong class="stat-value" id="totalUsers">-</strong>
        </div>
        <div class="stat">
            <span class="stat-label">Active users</span>
            <strong class="stat-value" id="activeUsers">-</strong>
        </div>
        <div class="stat">
            <span class="stat-label">Total requests</span>
            <strong class="stat-value" id="totalRequests">-</strong>
        </div>
        <div class="stat">
            <span class="stat-label">Open</span>
            <strong class="stat-value" id="openRequests">-</strong>
        </div>
        <div class="stat">
            <span class="stat-label">In progress</span>
            <strong class="stat-value" id="inProgressRequests">-</strong>
        </div>
        <div class="stat">
            <span class="stat-label">Resolved</span>
            <strong class="stat-value" id="resolvedRequests">-</strong>
        </div>
        <div class="stat">
            <span class="stat-label">Closed</span>
            <strong class="stat-value" id="closedRequests">-</strong>
        </div>
    </div>

    <h2 style="margin-bottom:16px">Manage</h2>
    <div class="grid cols-3">
        <a class="card feature" href="/admin/users">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.2a3.2 3.2 0 0 1 0 5.6M21 20c0-2.6-1.6-4.8-4-5.6"/></svg></div>
            <h3>Users</h3>
            <p>Review accounts, change roles and deactivate users.</p>
        </a>
        <a class="card feature" href="/admin/requests">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11M9 12h11M9 18h11M4 6l1.2 1.2L7 5.4M4 12l1.2 1.2L7 11.4M4 18l1.2 1.2L7 17.4"/></svg></div>
            <h3>Support requests</h3>
            <p>Assign agents and update the status of every request.</p>
        </a>
    </div>

    <p id="message" class="alert" role="status" style="margin-top:20px"></p>
</main>

<script>
const token = getToken();

if (!token || !["admin", "manager"].includes(getUserRole())) {
    window.location.href = "/staff/login";
}

async function loadDashboard() {
    try {
        const headers = {
            Authorization: `Bearer ${token}`
        };

        const usersResponse = await fetch(
            "/api/users",
            { headers }
        );

        if (usersResponse.status === 401) {
            handleUnauthorized();
            return;
        }

        const users = await usersResponse.json();

        if (!usersResponse.ok) {
            throw new Error(users.message);
        }

        const requestsResponse = await fetch(
            "/api/requests",
            { headers }
        );

        if (requestsResponse.status === 401) {
            handleUnauthorized();
            return;
        }

        const requests =
            await requestsResponse.json();

        if (!requestsResponse.ok) {
            throw new Error(requests.message);
        }

        document.getElementById(
            "totalUsers"
        ).textContent = users.length;

        document.getElementById(
            "activeUsers"
        ).textContent =
            users.filter(user => user.isActive).length;

        document.getElementById(
            "totalRequests"
        ).textContent = requests.length;

        document.getElementById(
            "openRequests"
        ).textContent =
            requests.filter(
                request => request.status === "open"
            ).length;

        document.getElementById(
            "inProgressRequests"
        ).textContent =
            requests.filter(
                request =>
                    request.status === "in-progress"
            ).length;

        document.getElementById(
            "resolvedRequests"
        ).textContent =
            requests.filter(
                request =>
                    request.status === "resolved"
            ).length;

        document.getElementById(
            "closedRequests"
        ).textContent =
            requests.filter(
                request =>
                    request.status === "closed"
            ).length;
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            error.message ||
            "Unable to load dashboard.";
    }
}

loadDashboard();
</script>

<%- include("../partials/footer") %>