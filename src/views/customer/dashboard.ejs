<%- include("../partials/head", { title: "Customer Dashboard" }) %>
<%- include("../partials/header") %>

<main id="main">
    <div class="page-head">
        <div>
            <span class="eyebrow">Customer portal</span>
            <h1>My support requests</h1>
            <p class="lead">Track the progress of your requests and chat with the support team.</p>
        </div>
        <a class="btn btn-primary" href="/customer/request/new">New request</a>
    </div>

    <div class="stats" id="stats"></div>

    <div id="requests" class="grid cards">
        <p class="muted">Loading requests...</p>
    </div>

    <p id="message" class="alert" role="status"></p>
</main>

<script>
const token = getToken();

if (!token || getUserRole() !== "customer") {
    window.location.href = "/customer/login";
}

async function loadRequests() {
    const container = document.getElementById("requests");

    try {
        const response = await fetch("/api/requests", {
            headers: { Authorization: `Bearer ${token}` }
        });

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data = await response.json();

        if (!response.ok) {
            container.innerHTML = "";
            document.getElementById("message").textContent = data.message;
            return;
        }

        renderStats(document.getElementById("stats"), data);

        if (data.length === 0) {
            container.className = "";
            container.innerHTML = `
                <div class="empty">
                    <p>You have no support requests yet.</p>
                    <p><a class="btn btn-primary btn-sm" href="/customer/request/new">Create your first request</a></p>
                </div>`;
            return;
        }

        container.innerHTML = data.map(request =>
            requestCardHtml(
                request,
                `/customer/requests/${request._id}`,
                "View request",
                escapeHtml(request.category)
            )
        ).join("");
    } catch (error) {
        container.innerHTML = "";
        document.getElementById("message").textContent =
            "Unable to load support requests.";
    }
}

loadRequests();
</script>

<%- include("../partials/footer") %>