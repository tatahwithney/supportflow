<%- include("../partials/head", { title: "Request Details" }) %>
<%- include("../partials/header") %>

<main id="main">
    <a class="back-link" href="/customer/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        Back to dashboard
    </a>

    <div class="detail-layout">
        <aside class="detail-side">
            <div class="card" id="request">
                <p class="muted">Loading request...</p>
            </div>
        </aside>

        <section class="chat-panel" aria-label="Conversation">
            <div class="chat-head">
                <div class="avatar" id="chatAvatar">S</div>
                <div>
                    <strong id="chatName">Support team</strong>
                    <span class="chat-sub" id="chatSub">Conversation</span>
                </div>
            </div>

            <div id="responses" class="chat-body" aria-live="polite">
                <div class="chat-empty">Loading messages...</div>
            </div>

            <form id="responseForm" class="composer">
                <label for="responseMessage" class="sr-only">Your message</label>
                <textarea id="responseMessage" rows="1" placeholder="Type a message" required></textarea>
                <button type="submit" class="send" aria-label="Send message">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3.4 20.4l17.5-7.5a1 1 0 0 0 0-1.8L3.4 3.6a1 1 0 0 0-1.4 1.2L4 11l9 1-9 1-2 6.2a1 1 0 0 0 1.4 1.2z"/></svg>
                </button>
            </form>
        </section>
    </div>

    <p id="message" class="alert toast" role="status"></p>
</main>

<script>
const token = getToken();

const requestId =
    "<%= requestId %>";

if (!token || getUserRole() !== "customer") {
    window.location.href = "/customer/login";
}

async function loadRequest() {
    try {
        const response = await fetch(
            `/api/requests/${requestId}`,
            {
                headers: {
                    Authorization:
                        `Bearer ${token}`
                }
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data =
            await response.json();

        if (!response.ok) {
            document.getElementById(
                "message"
            ).textContent = data.message;

            return;
        }

        document.getElementById(
            "request"
        ).innerHTML = `
            <h1>${escapeHtml(data.title)}</h1>
            <div class="badges" style="margin-top:12px">
                ${statusBadge(data.status)}
                ${priorityBadge(data.priority)}
                <span class="badge badge-muted">${escapeHtml(data.category)}</span>
            </div>
            <p class="req-desc">${escapeHtml(data.description)}</p>
            ${data.createdAt ? `<p class="meta">Opened ${escapeHtml(formatDate(data.createdAt))}</p>` : ""}
        `;

        const agentName = data.assignedAgent && data.assignedAgent.name;

        setChatHeader(
            agentName || "Support team",
            agentName ? "Assigned agent" : "Waiting for an agent to be assigned"
        );
    } catch (error) {
        document.getElementById(
            "message"
        ).textContent =
            "Unable to load request.";
    }
}

async function loadResponses() {
    try {
        const response = await fetch(
            `/api/requests/${requestId}/responses`,
            {
                headers: {
                    Authorization:
                        `Bearer ${token}`
                }
            }
        );

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data =
            await response.json();

        if (!response.ok) {
            document.getElementById(
                "responses"
            ).textContent = data.message;

            return;
        }

        if (data.length === 0) {
            document.getElementById(
                "responses"
            ).innerHTML =
                '<div class="chat-empty">No messages yet.<br>Send a message to start the conversation.</div>';

            return;
        }

        document.getElementById(
            "responses"
        ).innerHTML = renderChat(data);

        scrollChat();
    } catch (error) {
        document.getElementById(
            "responses"
        ).textContent =
            "Unable to load responses.";
    }
}

document
    .getElementById("responseForm")
    .addEventListener(
        "submit",
        async (event) => {
            event.preventDefault();

            const message =
                document.getElementById(
                    "message"
                );

            const response =
                await fetch(
                    `/api/requests/${requestId}/responses`,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            Authorization:
                                `Bearer ${token}`
                        },

                        body: JSON.stringify({
                            message:
                                document.getElementById(
                                    "responseMessage"
                                ).value
                        })
                    }
                );

            if (response.status === 401) {
                handleUnauthorized();
                return;
            }

            const data =
                await response.json();

            if (!response.ok) {
                message.textContent =
                    data.message;

                return;
            }

            document.getElementById(
                "responseMessage"
            ).value = "";

            message.textContent =
                "Response added successfully.";

            loadResponses();
        }
    );

loadRequest();
loadResponses();
</script>

<%- include("../partials/footer") %>