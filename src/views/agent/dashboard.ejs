<%- include("../partials/head", { title: "Agent Dashboard" }) %>
<%- include("../partials/header") %>

<main id="main">
    <div class="page-head">
        <div>
            <span class="eyebrow">Agent portal</span>
            <h1>Assigned requests</h1>
            <p class="lead">Open a request to reply to the customer and update its status.</p>
        </div>
    </div>

    <div class="stats" id="stats"></div>

    <div id="requests" class="grid cards">
        <p class="muted">Loading requests...</p>
    </div>

    <p id="message" class="alert" role="status"></p>
</main>

<script>
const token = getToken();

if (!token || getUserRole() !== "agent") {
    window.location.href = "/staff/login";
}

async function loadRequests() {
    const container = document.getElementById("requests");

    try {
        const response = await fetch("/api/requests", {
            headers: { Authorization: `Bearer ${token}` }
        });

        if (response.status === 401) {
            handleUnauthorized();
            return;
        }

        const data = await response.json();

        if (!response.ok) {
            container.innerHTML = "";
            document.getElementById("message").textContent = data.message;
            return;
        }

        renderStats(document.getElementById("stats"), data);

        if (data.length === 0) {
            container.className = "";
            container.innerHTML = `
                <div class="empty">
                    <p>No requests are currently assigned to you.</p>
                </div>`;
            return;
        }

        container.innerHTML = data.map(request =>
            requestCardHtml(
                request,
                `/agent/requests/${request._id}`,
                "Open request",
                "Customer: " + escapeHtml(request.customer?.name || "Unknown")
            )
        ).join("");
    } catch (error) {
        container.innerHTML = "";
        document.getElementById("message").textContent =
            "Unable to load requests.";
    }
}

loadRequests();
</script>

<%- include("../partials/footer") %>