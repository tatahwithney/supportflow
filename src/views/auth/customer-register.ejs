<%- include("../partials/head", { title: "Customer Registration" }) %>
<%- include("../partials/header") %>

<main id="main">
    <div class="auth-wrap">
        <div class="auth-aside">
                <span class="eyebrow">Customer portal</span>
                <p class="aside-title">Get help faster</p>
                <p>Create an account for your organization's support workspace.</p>
                <ul class="checklist">
                    <li>Submit requests in under a minute</li>
                    <li>See progress and replies as they happen</li>
                    <li>Your requests stay private to you</li>
                </ul>
            </div>
        <div class="auth-card">
            <div>
                <h1>Create customer account</h1>
                <p class="lead">Join your organization's support workspace.</p>
            </div>

            <form id="registerForm" class="form">
                <div class="field">
                    <label for="organizationSlug">Organization slug</label>
                    <input type="text" id="organizationSlug" placeholder="e.g. acme-support" required>
                    <span class="hint">Ask your organization for its workspace slug.</span>
                </div>
                <div class="field">
                    <label for="name">Full name</label>
                    <input type="text" id="name" autocomplete="name" required>
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" autocomplete="email" required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <input type="password" id="password" autocomplete="new-password" minlength="6" required>
                        <button type="button" class="pw-toggle" data-toggle-password="password" aria-label="Show password">Show</button>
                    </div>
                    <span class="hint">At least 6 characters.</span>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Create account</button>
            </form>

            <p id="message" class="alert" role="status"></p>

            <div class="auth-links">
                <span>Already registered? <a href="/customer/login">Customer sign in</a></span>
                <span>Need a new workspace? <a href="/organizations/register">Register an organization</a></span>
                <span>Staff member? <a href="/staff/register">Staff registration</a></span>
            </div>
        </div>
    </div>
</main>

<script>
document.getElementById("registerForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const message = document.getElementById("message");
    const payload = {
        organizationSlug: document.getElementById("organizationSlug").value,
        name: document.getElementById("name").value,
        email: document.getElementById("email").value,
        password: document.getElementById("password").value
    };

    try {
        const response = await fetch("/api/auth/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok) {
            message.textContent = data.message || "Unable to register.";
            return;
        }
        message.textContent = "Registration successful. Redirecting to customer login...";
        setTimeout(() => { window.location.href = "/customer/login"; }, 1000);
    } catch (error) {
        message.textContent = "Unable to connect to server.";
    }
});
</script>

<%- include("../partials/footer") %>
