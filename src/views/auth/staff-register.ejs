<%- include("../partials/head", { title: "Staff Registration" }) %>
<%- include("../partials/header") %>

<main id="main">
    <div class="auth-wrap">
        <div class="auth-aside">
                <span class="eyebrow">Support staff</span>
                <p class="aside-title">Join your team</p>
                <p>Register as an agent or manager for an existing organization.</p>
                <ul class="checklist">
                    <li>Handle requests assigned to you</li>
                    <li>Reply to customers in real conversations</li>
                    <li>Administrators are created with the organization</li>
                </ul>
            </div>
        <div class="auth-card">
            <div>
                <h1>Staff registration</h1>
                <p class="lead">Register as an agent or manager. You will need your staff registration key.</p>
            </div>

            <form id="registerForm" class="form">
                <div class="field">
                    <label for="organizationSlug">Organization slug</label>
                    <input type="text" id="organizationSlug" required>
                </div>

                <fieldset>
                    <legend>Account type</legend>
                    <div class="choices">
                        <label class="choice"><input type="radio" name="role" value="agent" checked> Support agent</label>
                        <label class="choice"><input type="radio" name="role" value="manager"> Manager</label>
                    </div>
                </fieldset>

                <div class="form-row">
                    <div class="field">
                        <label for="name">Full name</label>
                        <input type="text" id="name" autocomplete="name" required>
                    </div>
                    <div class="field">
                        <label for="email">Email</label>
                        <input type="email" id="email" autocomplete="email" required>
                    </div>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <input type="password" id="password" autocomplete="new-password" minlength="6" required>
                        <button type="button" class="pw-toggle" data-toggle-password="password" aria-label="Show password">Show</button>
                    </div>
                </div>
                <div class="field">
                    <label for="registrationKey">Staff registration key</label>
                    <input type="password" id="registrationKey" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Create staff account</button>
            </form>

            <p id="message" class="alert" role="status"></p>

            <div class="auth-links">
                <span>Already have a staff account? <a href="/staff/login">Staff login</a></span>
                <span>Customer? <a href="/customer/register">Customer registration</a></span>
            </div>
        </div>
    </div>
</main>

<script>
document.getElementById("registerForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const message = document.getElementById("message");
    const payload = {
        organizationSlug: document.getElementById("organizationSlug").value,
        name: document.getElementById("name").value,
        email: document.getElementById("email").value,
        password: document.getElementById("password").value,
        registrationKey: document.getElementById("registrationKey").value,
        role: document.querySelector('input[name="role"]:checked').value
    };

    try {
        const response = await fetch("/api/auth/staff/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok) {
            message.textContent = data.message || "Unable to register staff account.";
            return;
        }
        message.textContent = `${payload.role} account created successfully. Redirecting to staff login...`;
        setTimeout(() => { window.location.href = "/staff/login"; }, 1000);
    } catch (error) {
        message.textContent = "Unable to connect to server.";
    }
});
</script>

<%- include("../partials/footer") %>
